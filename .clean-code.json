{
  "allowConsole": [
    "core/clean_code/cli.py",
    "core/tests/*.py",
    "bin/*.js"
  ],
  "disableRules": [
    "suppressed-check",
    "skipped-test"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/vendor/**",
    "**/*.d.ts",
    "**/*.min.js",
    "core/tests/test_clean_check.py"
  ]
}
